---
import { statusLabels } from '../utils/eventStatus';

interface Props {
  status: string;
}

const { status = "planned" } = Astro.props;

const clsMap: Record<string, string> = {
  open:     'badge--open',
  sold_out: 'badge--sold-out',
  waitlist: 'badge--waitlist',
  planning: 'badge--planning',
  ended:    'badge--ended',
};
---

<span class={`badge ${clsMap[status]}`}>{statusLabels[status]}</span>
