---
import { statusLabels } from '../utils/eventStatus';

interface Props {
  status: string;
}

const { status = "planned" } = Astro.props;

const clsMap: Record<string, string> = {
  open:     'open',
  sold_out: 'sold-out',
  waitlist: 'waitlist',
  planning: 'planning',
  ended:    'ended',
};
---

<div class={`event-hero__status-bar event-hero__status-bar--${clsMap[status]}`}>
  {statusLabels[status]}
</div>
