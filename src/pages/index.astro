---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import siteLogo from '../assets/site-logo.png';

const allEvents = await getCollection('events');
const currentYear = new Date().getFullYear();

const activeEvents = allEvents
  .filter(r => !r.data.archived)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastEventsThisYear = allEvents
  .filter(r => r.data.archived && r.data.date.getFullYear() === currentYear)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Camp EKKO 2026 & 2027 Rally Schedule"
  description="See the full Camp EKKO 2026 & 2027 rally schedule — upcoming Winnebago Ekko owner gatherings with dates, locations, and registration links."
>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <div class="page-hero__text">
          <h1 class="sr-only">Camp EKKO</h1>
          <p class="page-hero__tagline">Winnebago Ekko Owner Community</p>
          <p class="page-hero__sub">Find your next Camp EKKO rally — volunteer-run events where Winnebago Ekko owners camp, connect, and explore together.</p>
        </div>
        <div class="page-hero__logo">
          <div class="page-hero__logo-badge">
            <Image src={siteLogo} alt="Camp EKKO" loading="eager"/>
          </div>
        </div>
      </div>
    </div>
    <div class="page-hero__stripes" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>

  <section class="events-section">
    <div class="container">

      {activeEvents.length > 0 ? (
        <>
          <h2 class="section-title">On the Calendar</h2>
          <div class="event-grid">
            {activeEvents.map(event => {
              return (
                <EventCard slug={event.id} data={event.data} />
              );
            })}
          </div>
        </>
      ) : (
        <div class="empty-state">
          <p>No upcoming events at the moment. Check back soon, or browse <a href="/archive/">past events</a>.</p>
        </div>
      )}

      {pastEventsThisYear.length > 0 && (
        <div class="past-this-year">
          <p class="past-this-year__label">Recently Wrapped</p>
          <div class="past-this-year__chips">
            {pastEventsThisYear.map(event => (
              <a href={`/events/${event.id}/`} class="chip">{event.data.title}</a>
            ))}
          </div>
          <a href="/archive/" class="past-this-year__archive-link">See full archive →</a>
        </div>
      )}

    </div>
  </section>

</BaseLayout>
