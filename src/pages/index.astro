---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import siteLogo from '../assets/site-logo.png';

const allEvents = await getCollection('events');

const activeEvents = allEvents
  .filter(r => !r.data.archived)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<BaseLayout
  title="Upcoming Events"
  description="Upcoming Camp EKKO gatherings for Winnebago Ekko owners — registration, schedules, and community resources."
>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <div class="page-hero__text">
          <h1 class="sr-only">Camp EKKO</h1>
          <p class="page-hero__tagline">Winnebago Ekko Owner Community</p>
          <p class="page-hero__sub">Find your next Camp EKKO rally — volunteer-run events where Winnebago Ekko owners camp, connect, and explore together.</p>
        </div>
        <div class="page-hero__logo">
          <div class="page-hero__logo-badge">
            <Image src={siteLogo} alt="Camp EKKO" loading="eager"/>
          </div>
        </div>
      </div>
    </div>
    <div class="page-hero__stripes" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>

  <section class="events-section">
    <div class="container">

      {activeEvents.length > 0 ? (
        <>
          <h2 class="section-title">What&#39;s Happening</h2>
          <div class="event-grid">
            {activeEvents.map(event => {
              return (
                <EventCard slug={event.id} data={event.data} />
              );
            })}
          </div>
        </>
      ) : (
        <div class="empty-state">
          <p>No upcoming events at the moment. Check back soon, or browse <a href="/archive/">past events</a>.</p>
        </div>
      )}

    </div>
  </section>

</BaseLayout>
