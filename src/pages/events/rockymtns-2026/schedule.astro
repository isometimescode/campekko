---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { occurrencesForDay } from '../../../utils/schedule';
import { dateRange } from '../../../utils/dates';
import townsMap from '../../../assets/schedule/towns-map.png';
import vendorMap from '../../../assets/schedule/vendor-map.png';

const EVENT_ID = 'rockymtns-2026';

const event = await getEntry('events', EVENT_ID);
const allSessions = await getCollection('schedule');
const sessions = allSessions.filter((s) => s.data.event.id === EVENT_ID);

const allVendors = await getCollection('vendors');
const vendors = allVendors
  .filter((v) => v.data.event.id === EVENT_ID)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const days = ['Thursday', 'Friday', 'Saturday'] as const;
const occurrencesByDay = Object.fromEntries(
  days.map((day) => [day, occurrencesForDay(sessions, day)]),
);

const categories = [...new Set(sessions.flatMap((s) => s.data.categories))].sort();

function formatCategory(cat: string) {
  return cat.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

const dayAbbr: Record<string, string> = { Thursday: 'Thu', Friday: 'Fri', Saturday: 'Sat' };
function repeatDetail(otherTimes: { day: string; startTime: string }[]) {
  if (!otherTimes.length) return null;
  return `Also offered ${otherTimes.map((t) => `${dayAbbr[t.day]} ${t.startTime}`).join(', ')}`;
}

const subtitle = event && event.data.date && event.data.end_date
  ? dateRange(event.data.date, event.data.end_date, { weekday: true })
  : null;

const pageTitle = event ? `${event.data.title}: Full Schedule` : 'Full Schedule';
---

<BaseLayout
  title={pageTitle}
  description="Filterable Thursday–Saturday schedule for Camp EKKO 2026 - Rocky Mountains: every chat, activity, and social, by day and category."
>

  <section class="page-hero page-hero--small">
    <div class="container">
      <div class="page-hero__inner">
        <div class="page-hero__text">
          {event && <p class="page-hero__label">{event.data.title}</p>}
          <h1 class="page-hero__title">Full Schedule</h1>
          {subtitle && <p class="page-hero__sub">{subtitle}</p>}
        </div>
      </div>
    </div>
    <div class="page-hero__stripes" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>

  <section class="schedule-section">
    <div class="container">
      <h2 class="section-title">Campground Maps</h2>
      <div class="map-gallery">
        <a href={townsMap.src} target="_blank" rel="noopener" class="map-gallery__item">
          <Image src={townsMap} alt="Camp EKKO campground map showing town and mayor territories with reference site locations" width={600} class="map-gallery__thumb" />
          <span class="map-gallery__caption">Towns &amp; Mayors</span>
        </a>
        <a href={vendorMap.src} target="_blank" rel="noopener" class="map-gallery__item">
          <Image src={vendorMap} alt="Detail map of the vendor section showing each vendor's campsite location" width={600} class="map-gallery__thumb" />
          <span class="map-gallery__caption">Vendor Section Detail</span>
        </a>
      </div>
    </div>
  </section>

  <section class="schedule-section">
    <div class="container">

      <div class="filter-bar">
        <div class="filter-group" data-filter-group="day">
          <span class="filter-group__label">Day</span>
          <button type="button" class="filter-btn filter-btn--active" data-value="all">All</button>
          {days.map((day) => (
            <button type="button" class="filter-btn" data-value={day}>{day}</button>
          ))}
        </div>
        <div class="filter-group" data-filter-group="category">
          <span class="filter-group__label">Category</span>
          <button type="button" class="filter-btn filter-btn--active" data-value="all">All</button>
          {categories.map((cat) => (
            <button type="button" class="filter-btn" data-value={cat}>{formatCategory(cat)}</button>
          ))}
        </div>
      </div>

      {days.map((day) => (
        <div class="day-section" data-day-section={day}>
          <h2 class="archive-year">{day}</h2>
          <div class="schedule-list">
            {occurrencesByDay[day].map((occ) => (
              <details
                class:list={['schedule-row', { 'schedule-row--highlight': occ.categories.includes('logistics') }]}
                data-day={day}
                data-categories={occ.categories.join(' ')}
              >
                <summary class="schedule-row__summary">
                  <span class="schedule-row__time">{occ.startTime}{occ.endTime ? ` – ${occ.endTime}` : ''}</span>
                  <span class="schedule-row__main">
                    <span class="schedule-row__title">{occ.title}</span>
                    <span class="schedule-row__host">
                      Hosted By: {occ.host}
                      {occ.otherTimes.length > 0 && (
                        <span class="schedule-row__repeat-badge">🔁</span>
                      )}
                    </span>
                  </span>
                  <span class="schedule-row__location">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {occ.location}
                  </span>
                </summary>
                {repeatDetail(occ.otherTimes) && <p class="schedule-row__repeat-detail">🔁 {repeatDetail(occ.otherTimes)}</p>}
                {occ.description && <p class="schedule-row__description">{occ.description}</p>}
              </details>
            ))}
          </div>
        </div>
      ))}

      <p class="empty-state" data-empty-state hidden>No sessions match the selected filters.</p>

    </div>
  </section>

  <section class="schedule-section">
    <div class="container">
      <h2 class="section-title">Onsite Vendors</h2>
      <div class="vendor-grid">
        {vendors.map((vendor) => (
          <div class="vendor-card">
            <div class="vendor-card__header">
              <h3 class="vendor-card__name">{vendor.data.name}</h3>
              {vendor.data.location && (
                <span class="vendor-card__location">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {vendor.data.location}
                </span>
              )}
            </div>
            {vendor.data.note && <span class="vendor-card__note">{vendor.data.note}</span>}
            <p class="vendor-card__description">{vendor.data.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const filterBar = document.querySelector('.filter-bar');
    const rows = document.querySelectorAll<HTMLElement>('.schedule-row');
    const sections = document.querySelectorAll<HTMLElement>('.day-section');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

    const active: Record<string, string> = { day: 'all', category: 'all' };

    function applyFilters() {
      let anyVisible = false;
      rows.forEach((row) => {
        const dayMatch = active.day === 'all' || row.dataset.day === active.day;
        const categories = row.dataset.categories?.split(' ') ?? [];
        const catMatch = active.category === 'all' || categories.includes(active.category);
        const visible = dayMatch && catMatch;
        row.hidden = !visible;
        if (visible) anyVisible = true;
      });
      sections.forEach((section) => {
        const hasVisibleRow = section.querySelector('.schedule-row:not([hidden])');
        section.hidden = !hasVisibleRow;
      });
      if (emptyState) emptyState.hidden = anyVisible;
    }

    filterBar?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
      if (!button) return;
      const group = button.closest<HTMLElement>('[data-filter-group]');
      const groupName = group?.dataset.filterGroup;
      if (!groupName) return;

      active[groupName] = button.dataset.value ?? 'all';
      group?.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('filter-btn--active'));
      button.classList.add('filter-btn--active');

      applyFilters();
    });

    let openBeforePrint: boolean[] = [];
    window.addEventListener('beforeprint', () => {
      openBeforePrint = Array.from(rows).map((row) => (row as HTMLDetailsElement).open);
      rows.forEach((row) => { (row as HTMLDetailsElement).open = true; });
    });
    window.addEventListener('afterprint', () => {
      rows.forEach((row, i) => { (row as HTMLDetailsElement).open = openBeforePrint[i] ?? false; });
    });
  </script>

</BaseLayout>
